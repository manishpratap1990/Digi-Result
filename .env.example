# DigiResult — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Supabase ───────────────────────────────────────────────
# Your Supabase project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (Settings > API > Project API Keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — NEVER expose to browser (Settings > API > Project API Keys > service_role)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Demo Mode ──────────────────────────────────────────────
# Password for the demo admin login (used only when Supabase is not configured).
# In production with Supabase configured, this variable is unused.
DEMO_ADMIN_PASSWORD=admin123
